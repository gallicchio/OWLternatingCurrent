(footprint "Coil_BAT"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "PCB coil (COIL_BAT), the footprint's own copper, a net tie between pads 1 and 2: 4 layers in series (F/In1/In2/B), 10 + 10 + 10.5 + 10.5 turns (41.0 in all), r 7.00-11.00 mm (copper edges), 0.20 mm track at 0.362-0.380 mm pitch; L 37.4 uH, R 5.74 ohm (DC, 1 oz, 20 C); 3 layer changes (pads 3-5). Pads 1, 2 at +y, 11.75 mm out; current into pad 1 turns clockwise seen from the top. Keep-out to r 11.30, courtyard r 11.25. Generated by gen/coils.py")
	(tags "PCB coil spiral inductor net tie")
