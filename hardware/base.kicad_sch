	(text_box "U1, TPS54302: 12 V to 4.8 V, 3 A, 400 kHz. 4.8\nV, not 5: 0.596 V x (1 + 36k/5.1k) = 4.80 V\nfrom a Preferred and a Basic resistor, and it\nkeeps the audio amplifier (5.25 V absolute\nmaximum) clear of its limit. The rail is\ncalled +5V; it runs the LEDs, the perch\ndrivers, the audio amplifier and the tree. EN\nthrough 100k/22k: the buck starts above 6.7 V\n(EN may not see 12 V)." (exclude_from_sim no) (at 144.7800 82.5500 0) (size 43.1800 17.7800)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "70aa2bc6-6f53-2954-6a62-c806dceba977"))
	(text "VSYS AND 3.3 V" (exclude_from_sim no) (at 290.8300 33.0200 0) (effects (font (size 2.00 2.00) (bold yes)) (justify left bottom)) (uuid "c93b6a01-83f8-a970-8080-84d0b68a7a3a"))
