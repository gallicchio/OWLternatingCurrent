(footprint "Coil_LEV"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "PCB coil (COIL_LEV), the footprint's own copper, a net tie between pads 1 and 2: 3 layers in series (F/In1/In2), 14.5 + 14.5 + 14.1 turns (43.1 in all), r 4.00-15.00 mm (copper edges), 0.50 mm track at 0.723-0.746 mm pitch; L 30.1 uH, R 2.56 ohm (DC, 1 oz, 20 C); 3 layer changes (pads 3-5). Pads 1, 2 at +y, 15.75 mm out; current into pad 1 turns clockwise seen from the top. Keep-out to r 15.30, courtyard r 15.25. B.Cu: no spiral; the inner end leaves along x = -2.30 to pad 2; the sensor's hole (r < 3.50) and a 3.0 mm corridor along +y stay open to tracks. Generated by gen/coils.py")
	(tags "PCB coil spiral inductor net tie")
