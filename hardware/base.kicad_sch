	(label "THEREMIN_VOL" (at 201.9300 281.9400 0) (effects (font (size 1.00 1.00)) (justify left bottom)) (uuid "3996c6e6-e0a5-f9d4-0d04-c50382004e51"))
	(text_box "Each oscillator: a 74LVC1G14 with 100k feedback;\nits capacitor is 15 pF plus a gold copper shape\n(the moon, the ghost: their pads AE1 and AE2),\nabout 500 kHz. A hand 10 cm away adds a fraction\nof a picofarad and lowers the frequency by a few\nkHz; the RP2354A's PIO counts each for 10 ms\n(100 Hz resolution), 100 times a second. Pitch\nfrom the moon, volume from the ghost. The two\nrun about 20 % apart (different shapes), so they\ndo not lock to each other." (exclude_from_sim no) (at 22.8600 226.0600 0) (size 46.9900 20.3200)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "990973a4-6a58-98bb-b575-76d0d9723008"))
