	(text_box "VSYS is 4.8 V less a Schottky drop, or USB's\n5 V less one: so the RP2354A, the sensors\nand the LED drivers' logic run from USB\nalone (to program the board without the\nadapter), while USB never feeds the 4.8 V\nrail and its loads. U2, XC6206: 3.3 V, 200\nmA, stable with ceramic capacitors; the\nlogic draws about 110 mA. Dropout 0.25 V:\nVSYS may sag to 3.6 V." (exclude_from_sim no) (at 290.8300 82.5500 0) (size 40.6400 17.7800)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "6de5cb05-bc15-ad0d-7ed2-9e9300d32571"))
