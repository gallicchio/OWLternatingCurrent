		(instances (project "OWLternatingCurrent" (path "/0ee13ddb-1c12-f416-8576-ee8890b4675e/8f976193-3ca0-4b18-df0e-ba7338335e40" (reference "LS1") (unit 1)))))
	(text_box "AUDIO is PWM at about 150 kHz. Two RC stages\n(1k, 10n: 16 kHz each) leave the tone and take\nthe carrier down 38 dB; 22n and 100k pass 72 Hz\nand up. U14, NS4150B: class D, gain 240k/100k =\n2.4. Full scale is about 0.5 W in the 8 ohm, 23\nmm speaker, more than a bedroom needs: the\nfirmware sets the volume. SW3 off (or no 12 V\nadapter) shuts U14 down: no sound at all,\nwhatever the firmware does." (exclude_from_sim no) (at 22.8600 152.4000 0) (size 45.7200 17.7800)
		(margins 0.9525 0.9525 0.9525 0.9525) (stroke (width 0) (type default))
		(fill (type color) (color 255 255 194 1)) (effects (font (size 1.00 1.00)) (justify left top)) (uuid "299afe8c-ea3b-bb35-4d66-bf6f010d9841"))
